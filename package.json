{
  "name": "neko-defense-dashboard",
  "version": "1.0.0",
  "description": "🐾⚡ NEKO-ARC Defense System Dashboard - Real-time threat monitoring with ASCII art, nyaa~!",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --fix --ext .js,.jsx,.ts,.tsx",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "server": "node server/index.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "prepare": "husky",
    "cypress:open": "cypress open --config-file cypress.config.js",
    "cypress:run": "cypress run --config-file cypress.config.js",
    "cypress:run:record": "cypress run --config-file cypress.config.js --record --key $CYPRESS_RECORD_KEY",
    "test:unit": "echo 'Unit tests: Add Jest configuration later'",
    "test:e2e": "start-server-and-test dev http://localhost:3000 cypress:run",
    "test:e2e:record": "start-server-and-test dev http://localhost:3000 cypress:run:record",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test": "npm run test:all",
    "ci:install": "npm ci",
    "ci:lint": "npm run lint:check && npm run format:check",
    "ci:build": "npm run build",
    "ci:test:unit": "npm run test:unit",
    "ci:test:e2e": "npm run test:e2e:record",
    "ci:test": "npm run ci:test:unit && npm run ci:test:e2e"
  },
  "dependencies": {
    "@apollo/client": "^3.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@types/recharts": "^2.0.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "@vitalets/google-translate-api": "^9.2.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "deepl-node": "^1.13.0",
    "dotenv": "^16.3.1",
    "emoji-picker-react": "^4.15.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.23.24",
    "franc": "^6.2.0",
    "graphql": "^16.11.0",
    "helmet": "^8.1.0",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "multer": "^2.0.2",
    "next": "^14.2.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-i18next": "^16.0.1",
    "react-markdown": "^10.1.0",
    "react-quill": "^2.0.0",
    "react-responsive": "^10.0.1",
    "react-virtualized": "^9.22.6",
    "reactflow": "^11.11.4",
    "recharts": "^3.3.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.14.7",
    "@eslint/eslintrc": "^3.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "axe-core": "^4.11.0",
    "concurrently": "^8.2.2",
    "cypress": "^15.4.0",
    "cypress-axe": "^1.7.0",
    "cypress-real-events": "^1.15.0",
    "eslint-config-next": "^16.0.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest-canvas-mock": "^2.5.2",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "puppeteer": "^24.25.0",
    "start-server-and-test": "^2.1.2",
    "typescript": "^5.9.3"
  }
}
