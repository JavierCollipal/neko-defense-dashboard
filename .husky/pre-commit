# 🐾⚡ NEKO DEFENSE PRE-COMMIT HOOK ⚡🐾
# Auto-fix ESLint errors in staged files only
# Compatible with Husky v9 and v10

echo "🐾 Running lint-staged to fix staged files, nyaa~!"
npx lint-staged

if [ $? -ne 0 ]; then
  echo "❌ Some lint errors couldn't be auto-fixed!"
  echo "Please fix the remaining errors and try again, desu~!"
  exit 1
fi

echo "✅ All staged files linted successfully, nyaa~!"
