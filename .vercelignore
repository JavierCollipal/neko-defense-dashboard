# Exclude Puppeteer test files from Vercel build
# These files contain browser-specific code that shouldn't be compiled server-side

puppeteer-*.ts
puppeteer-*.js
**/puppeteer-*.ts
**/puppeteer-*.js

# Test directories
__tests__/
**/__tests__/
*.test.ts
*.test.js
*.spec.ts
*.spec.js

# Development files
.env.local
.env.*.local
